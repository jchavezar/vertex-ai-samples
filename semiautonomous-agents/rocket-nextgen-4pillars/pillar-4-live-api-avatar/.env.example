# ==============================================================================
# Pillar 4: Gemini Live API & Video Avatar Engine Environment Configuration
# ==============================================================================

# Google Cloud Platform Project & Location
GCP_PROJECT_ID=vtxdemos
GCP_LIVE_LOCATION=us-central1
GCP_LOCATION=global

# Live API Models (2026 Next-Gen Standards)
MODEL_LIVE_VOICE_AVATAR=gemini-3.8-live
MODEL_LIVE_EXTENDED=gemini-3.8-live-extended-thinking
MODEL_SUBAGENT_DECOMPOSE=gemini-3.1-flash-lite
MODEL_SUBAGENT_TASK=gemini-3.8-flash

# Built-in Video Avatar Persona
DEFAULT_AVATAR_PERSONA=Kira
DEFAULT_VOICE_NAME=Aoede

# Audio Stream & VAD Configuration
LIVE_AUDIO_INPUT_SAMPLE_RATE=16000
LIVE_AUDIO_OUTPUT_SAMPLE_RATE=24000
LIVE_VAD_SILENCE_MS=600

# Fast API Application Port
PORT=8080
