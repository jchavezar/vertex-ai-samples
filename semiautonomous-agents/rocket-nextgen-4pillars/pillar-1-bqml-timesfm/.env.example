# ==============================================================================
# Pillar 1: BigQuery ML AI.FORECAST (TimesFM) Environment Configuration
# ==============================================================================

# Google Cloud Platform Project & Location
GCP_PROJECT_ID=vtxdemos
GCP_LOCATION=us-central1

# BigQuery Dataset & Production Servicing Metrics Table
BQ_DATASET_ID=rocket_nextgen_timesfm
BQ_TABLE_ID=portfolio_metrics
BQ_TABLE_FQN=vtxdemos.rocket_nextgen_timesfm.portfolio_metrics

# TimesFM Forecast Defaults
TIMESFM_DEFAULT_HORIZON=12
TIMESFM_DEFAULT_CONFIDENCE=0.90
TIMESFM_DEFAULT_RATE_SHOCK_BPS=-50

# Fast API Application Port
PORT=8080
