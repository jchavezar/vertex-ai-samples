# ── GCP Credentials ────────────────────────────────────────────────────────────
PROJECT_NUMBER=your-gcp-project-number
PROJECT_ID=your-gcp-project-id

# ── Discovery Engine Config ───────────────────────────────────────────────────
# ENGINE_ID is your agent app's ID (Agent Builder Console)
# CONNECTOR_ID is the Federated SharePoint Online Connector ID
ENGINE_ID=your-engine-id
CONNECTOR_ID=your-sharepoint-connector-id

# ── Workforce Identity Federation (WIF) ───────────────────────────────────────
# Enter your GCP Workforce Pool IDs to exchange Entra tokens to GCP tokens
WIF_POOL_ID=your-wif-pool-id
WIF_PROVIDER_ID=your-wif-provider-id

# ── Microsoft Entra Application Registrations ─────────────────────────────────
# TENANT_ID is your Entra/Azure directory ID
# CONNECTOR_CLIENT_ID is your SharePoint Connector App Client ID
CONNECTOR_CLIENT_ID=00000000-0000-0000-0000-000000000000
CONNECTOR_CLIENT_SECRET=your-entra-connector-secret
TENANT_ID=00000000-0000-0000-0000-000000000000

# ── Server Config ─────────────────────────────────────────────────────────────
BACKEND_PORT=8003
SHAREPOINT_DOMAIN=your-tenant.sharepoint.com
