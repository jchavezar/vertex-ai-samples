# ==============================================================================
# Pillar 5: AI Real Estate Marketplace & Hybrid Vector Engine Configuration
# ==============================================================================

# Google Cloud Platform Project & Location
GCP_PROJECT_ID=vtxdemos
GCP_LOCATION=us-central1
GCP_GLOBAL_LOCATION=global

# Google Cloud Storage Media & Video Asset Bucket
GCS_MEDIA_BUCKET=vtxdemos-abnb-images
GCS_CDN_URL=https://storage.googleapis.com/vtxdemos-abnb-images/rocket_re_cdn/v1
GCS_TOURS_URL=https://storage.googleapis.com/vtxdemos-abnb-images/tours/v1
GCS_VEO_TOURS_URL=https://storage.googleapis.com/vtxdemos-abnb-images/tours/veo

# Embedding & Multimodal Models (2026 Next-Gen Standards)
MODEL_TEXT_EMBEDDING=gemini-embedding-001
MODEL_IMAGE_EMBEDDING=multimodalembedding@001
MODEL_MULTIMODAL_JUDGE=gemini-3.8-flash
MODEL_VEO_WALKTHROUGH=veo-3.1-fast-generate-001

# Hybrid Search Weights
HYBRID_SEMANTIC_WEIGHT=0.42
HYBRID_VISUAL_WEIGHT=0.20
HYBRID_KEYWORD_WEIGHT=0.38

# Judge Cache Configuration
P5_JUDGE_CACHE_PATH=/tmp/p5_judge_cache.json

# Fast API Application Port
PORT=8080
