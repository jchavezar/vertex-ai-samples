# ==============================================================================
# Pillar 3: Tri-Modal Grounding Engine Environment Configuration
# ==============================================================================

# Google Cloud Platform Project & Location
GCP_PROJECT_ID=vtxdemos
GCP_LOCATION=global
GCP_REGIONAL_LOCATION=us-central1

# Places API (New) Configuration (Uses ADC token with billing project header)
GOOGLE_CLOUD_USER_PROJECT=vtxdemos

# Grounding Models (2026 Next-Gen Standards)
MODEL_GROUNDED_CHAT=gemini-3.8-flash
MODEL_FRONTIER_REASONING=gemini-4-argon
MODEL_GROUNDED_FALLBACK=gemini-3.1-flash-lite

# Tail-Latency Hedge Parameters
P3_HEDGE_TIMEOUT_SEC=8.0
P3_HEARTBEAT_INTERVAL_SEC=6.0

# Fast API Application Port
PORT=8080
