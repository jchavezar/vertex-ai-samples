# ============================================================================
# Rocket Companies × Google Gemini · Next-Gen 5-Pillar AI Studio (v35)
# Customer Environment Variables Template (.env.example)
# ============================================================================
# Copy this file to `.env` and replace with your Google Cloud project values:
#   cp .env.example .env && set -a && source .env && set +a
# ============================================================================

# 1. Core Google Cloud & Vertex AI Configuration
GCP_PROJECT_ID="your-gcp-project-id"          # Default in demo: vtxdemos
GCP_LOCATION="global"                         # Default for Gemini 3.8 Flash / Lite / Argon / Veo 3.1
GCP_LIVE_LOCATION="us-central1"               # Required for Gemini 3.8 Live WebSocket & Embeddings
CLOUD_RUN_REGION="us-central1"                # Target region for Cloud Run deployment
CLOUD_RUN_SERVICE="rocket-polymorphic-search" # Cloud Run service name

# 2. Pillar 1 — BigQuery ML AI.FORECAST (TimesFM 2.0)
BQ_DATASET_ID="rocket_nextgen_timesfm"        # BigQuery dataset containing servicing time-series
BQ_TABLE_ID="portfolio_metrics"               # Table with (metric_id, week_dt, metric_value)
# Optional override: full table FQN (`project.dataset.table`)
# BQ_TABLE_FQN="your-gcp-project-id.rocket_nextgen_timesfm.portfolio_metrics"

# 3. Pillar 2 & Pillar 5 — Cloud Storage Media & Tours Bucket
GCS_MEDIA_BUCKET="your-gcs-media-bucket"      # Default in demo: vtxdemos-abnb-images
# Optional overrides for custom CDN paths:
# GCS_LIVE_CATALOG_URL="https://storage.googleapis.com/your-gcs-media-bucket/rocket_re_cdn/v1/catalog_108_index.json"
# VEO_MANIFEST_GCS_URL="https://storage.googleapis.com/your-gcs-media-bucket/tours/veo/veo_tours_manifest.json"

# 4. Pillar 5 — Multimodal Gemini Judge Configuration
P5_JUDGE_MEDIA_RESOLUTION="LOW"               # LOW (~8.0s latency) or MEDIUM (~9.7s latency)
# P5_JUDGE_CACHE_PATH="/tmp/p5_judge_cache.json"

# 5. Studio Authentication & Session Security
ROCKET_USER="rocket"                          # Studio login username
ROCKET_PASS="ReplaceWithStrongPassword!"      # Studio login password
ROCKET_SECRET="replace-with-32-byte-hmac-key" # HMAC-SHA256 cookie & token signing secret
PORT="8080"                                   # Local or Cloud Run HTTP/WebSocket listen port
