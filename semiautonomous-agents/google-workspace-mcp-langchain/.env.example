# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Google OAuth 2.0 Web Client Credentials (for Customer AuthN/AuthZ)
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
# Authorized redirect URI configured in GCP Console (e.g., http://localhost:8003 or http://localhost:8003/api/auth/callback)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8003
