FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi>=0.115.0 \
    uvicorn>=0.32.0 \
    pydantic>=2.9.0 \
    google-cloud-firestore>=2.19.0

COPY amex_job/ amex_job/
COPY monarch_app/ monarch_app/

ENV PORT=8080
ENV GCP_PROJECT_ID=vtxdemos

EXPOSE 8080

CMD ["uvicorn", "monarch_app.server:app", "--host", "0.0.0.0", "--port", "8080"]
